# ============================================================
# 复制本文件为 .env 后按需修改（.env 已被 .gitignore 忽略）
#   cp .env.example .env        # Windows: copy .env.example .env
# 云端部署时不要上传 .env，直接在平台的环境变量/Secrets 里配同样的键。
# ============================================================

# ---------- 运行模式 ----------
# live = 连接 Binance 公共行情（只读公共数据，绝不使用真实资金）
# mock = 完全离线，用本地随机游走生成行情（教室断网兜底）
RUN_MODE=live

# ---------- 交易对与周期 ----------
# 多个用逗号分隔；每个 "交易对 × 周期" 组合会订阅一条组合流
SYMBOLS=BTCUSDT,ETHUSDT
# 注意大小写：1m = 分钟，1M = 月（两者不同周期）
# 1y 不需要订阅：后端会用 1M 的 12 根月 K 现场聚合成年 K
INTERVALS=1m,5m,1h,1d,1w,1M,1y
KLINE_LIMIT=1000

# ---------- 行情源（公共接口，无需 API Key） ----------
# 阶段二起统一走币安官方"仅公共行情"域名（只读、无下单能力、通常更通）
# WS 主域名
BINANCE_WS_URL=wss://data-stream.binance.vision/ws
# WS 备用域名，按顺序自动切换
BINANCE_WS_FALLBACKS=wss://stream.binance.com:9443/ws,wss://stream.binance.com:443/ws

# REST 主域名
BINANCE_REST_URL=https://data-api.binance.vision
# REST 备用域名（仅当 vision 域名不可达时降级）
BINANCE_REST_FALLBACK=https://api.binance.com

# 注意：资金费率 / 多空比来自 U 本位合约接口（fapi.binance.com），
# data-api.binance.vision 上不存在这些路径（实测 404），因此这两项仍走 fapi：
# 失败时后端带 60 秒负缓存并回退默认值，页面标注「需后端 / 默认值」。

# ---------- WebSocket 指数退避重连 ----------
WS_BACKOFF_BASE=1.0      # 首次重连等待秒数
WS_BACKOFF_MAX=60.0      # 单次等待上限秒数
WS_BACKOFF_JITTER=0.3    # 抖动比例，避免同一时刻集体重连
WS_IDLE_TIMEOUT=30.0     # 超过多久没收到数据视为假死，主动重连

# ---------- 模拟撮合参数 ----------
FEE_RATE=0.001           # 单边手续费 0.1%
INITIAL_CAPITAL=10000.0  # 模拟初始资金 USDT

# ---------- 前端默认策略与执行参数 ----------
# grid = 网格交易 / martingale = 马丁格尔 / trend = 趋势跟踪
DEFAULT_STRATEGY=grid
# 打开页面默认周期（1m/5m/1h/1d/1w/1M/1y）
DEFAULT_INTERVAL=1m
# 默认市场模式：spot = 现货；futures = 合约
DEFAULT_MODE=spot
# 合约模式默认杠杆（1~20）
DEFAULT_LEVERAGE=5

# ---------- Mock 行情节奏 ----------
MOCK_TICK_SECONDS=0.4    # Mock 模式下多久推进一次行情（越小越"活泼"）

# ---------- 服务地址 ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# 前端访问后端用的公网/内网地址（Streamlit Cloud 部署时必须改成公网地址）
BACKEND_BASE_URL=http://127.0.0.1:8000

# ---------- 注意 ----------
# 本项目为纯模拟（Paper Trading），以下字段永远留空/不使用。
# 如需扩展成真实接入，务必自行实现风控并单独评审。
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
